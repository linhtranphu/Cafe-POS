# Local Print Bridge Configuration (Go version with chromedp)

# Server Port
PORT=3001

# Default Printer IPs (configure these for your local network)
DEFAULT_BILL_PRINTER_IP=192.168.1.115
DEFAULT_BILL_PRINTER_PORT=9100

DEFAULT_LABEL_PRINTER_IP=192.168.1.116
DEFAULT_LABEL_PRINTER_PORT=9100

# Logging
LOG_LEVEL=info

# Connection Timeout (seconds)
PRINTER_TIMEOUT=5
