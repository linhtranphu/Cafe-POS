# Local Print Bridge Configuration

# Server Port
PORT=3001

# Backend API URL (EC2)
BACKEND_URL=https://api.your-domain.com

# Default Printer IPs (optional - can be configured via API)
DEFAULT_BILL_PRINTER_IP=192.168.1.100
DEFAULT_BILL_PRINTER_PORT=9100

DEFAULT_LABEL_PRINTER_IP=192.168.1.101
DEFAULT_LABEL_PRINTER_PORT=9100

# Logging
LOG_LEVEL=info

# Connection Timeout (ms)
PRINTER_TIMEOUT=5000
