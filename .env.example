# Docker Hub Configuration
DOCKER_USERNAME=your_docker_username

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_secure_password
MONGO_INITDB_DATABASE=cafe_pos

# Backend Configuration
# QUAN TRỌNG: Với Replica Set, phải có ?replicaSet=rs0&authSource=admin
MONGODB_URI=mongodb://admin:your_secure_password@mongodb:27017/cafe_pos?replicaSet=rs0&authSource=admin
MONGODB_DATABASE=cafe_pos
JWT_SECRET=your_jwt_secret_key_change_this_min_32_chars
PORT=3000
TZ=Asia/Ho_Chi_Minh

# Print Bridge Configuration
# Local Print Bridge URL for printing functionality
# Use http://localhost:3001 if Print Bridge runs on same machine
# Use http://192.168.1.X:3001 if Print Bridge runs on different machine
PRINT_BRIDGE_URL=http://localhost:3001

# Frontend Configuration
VITE_API_URL=http://localhost/api

# Production Notes:
# 1. Change all default passwords
# 2. Use strong JWT secret (min 32 characters): openssl rand -base64 32
# 3. Use environment-specific MongoDB credentials
# 4. Never commit actual .env file to git
# 5. Backend runs on port 3000 (internal), exposed via Nginx on port 80
# 6. Frontend runs on port 80 (Nginx)
# 7. MongoDB Replica Set cần thiết cho batch system (transactions)
# 8. Chạy ./migrate-to-replica-set.sh để migrate từ standalone sang replica set
